            "body": { "mode": "raw", "raw": "{\n  \"nha_cung_cap\": \"Cong ty ABC\",\n  \"ghi_chu\": \"Nhap hang thang 7\",\n  \"items\": [\n    { \"san_pham_id\": 1, \"so_luong\": 50, \"don_gia_nhap\": 7500000 },\n    { \"san_pham_id\": 2, \"so_luong\": 30, \"don_gia_nhap\": 950000 }\n  ]\n}" },
            "url": "{{base_url}}/purchase-orders"
          }
