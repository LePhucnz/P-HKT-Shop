            "body": { "mode": "raw", "raw": "{\n  \"ten_km\": \"Giam 20% da sua\",\n  \"gia_tri\": 20,\n  \"ngay_ket_thuc\": \"2026-08-31\"\n}" },
            "url": "{{base_url}}/promotions/{{promotion_id}}"
          }
        },
        {
          "name": "Toggle (bat/tat)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/promotions/{{promotion_id}}/toggle"
          }
        },
        {
          "name": "Delete",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/promotions/{{promotion_id}}"
          }
        }
      ]
